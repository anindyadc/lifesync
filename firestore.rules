rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getProfile() {
      return get(/databases/$(database)/documents/artifacts/default-app-id/public/data/userProfiles/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 'role' in getProfile() && getProfile().role == 'admin';
    }

    // Securely checks for app permissions.
    // It now verifies that 'allowedApps' exists before checking for the appName.
    function hasAppPermission(appName) {
      let profile = getProfile();
      return isAdmin() || (
        isAuthenticated() &&
        'allowedApps' in profile &&
        appName in profile.allowedApps
      );
    }

    // --- RULES ---

    // 1. User Profiles Rule
    // `create` is restricted to the exact default-role shape the signup flow
    // writes (AuthScreen.jsx) — without this, ownership alone would let any
    // authenticated user create their own profile doc with role: 'admin' and
    // arbitrary allowedApps, a full privilege escalation.
    match /artifacts/default-app-id/public/data/userProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.allowedApps == [];
      allow update, delete: if isAdmin();
    }

    // 2. Generic, Secure Rule for All App Data
    // This single rule replaces the multiple, verbose rules for each app.
    // It dynamically checks permission based on the collection name.
    match /artifacts/default-app-id/users/{userId}/{appName}/{docId} {
      allow read, write: if isOwner(userId) && hasAppPermission(appName);
    }
    
    // 3. Specific rule for WalletWatch settings (as it has a unique path)
    match /artifacts/default-app-id/users/{userId}/settings/walletConfig {
      allow read, write: if isOwner(userId) && hasAppPermission('walletwatch');
    }

    // 4. Specific rule for TaskFlow settings (custom categories), same unique-path reason
    match /artifacts/default-app-id/users/{userId}/settings/taskConfig {
      allow read, write: if isOwner(userId) && hasAppPermission('taskflow');
    }

    // 5. Specific rule for TaskFlow's Quick List — its own top-level collection
    // ("quickTasks") would otherwise make the generic rule #2 check for
    // 'quickTasks' in allowedApps instead of 'taskflow', so it needs an explicit block.
    match /artifacts/default-app-id/users/{userId}/quickTasks/{docId} {
      allow read, write: if isOwner(userId) && hasAppPermission('taskflow');
    }

    // 6. Specific rule for WalletWatch's Misc Expense draft, same unique-path reason as walletConfig
    match /artifacts/default-app-id/users/{userId}/settings/miscExpenseDraft {
      allow read, write: if isOwner(userId) && hasAppPermission('walletwatch');
    }

    // 7. Specific rule for ChangeManager's changelog entries. The collection
    // is named 'changelogs' but the app's allowedApps key is 'changemanager',
    // so the generic rule #2 would wrongly check for 'changelogs' in
    // allowedApps instead of 'changemanager' (same reason as quickTasks above).
    match /artifacts/default-app-id/users/{userId}/changelogs/{docId} {
      allow read, write: if isOwner(userId) && hasAppPermission('changemanager');
    }

    // 8. Specific rules for WalletWatch's Fixed Expenses (recurring bills) —
    // top-level collections whose path segments ('fixedExpenseTemplates',
    // 'fixedExpenseInstances') don't match the 'walletwatch' allowedApps key,
    // same reason as quickTasks/changelogs above.
    match /artifacts/default-app-id/users/{userId}/fixedExpenseTemplates/{docId} {
      allow read, write: if isOwner(userId) && hasAppPermission('walletwatch');
    }
    match /artifacts/default-app-id/users/{userId}/fixedExpenseInstances/{docId} {
      allow read, write: if isOwner(userId) && hasAppPermission('walletwatch');
    }

    // 9. Specific rule for WalletWatch's Credit Card billing config, same unique-path
    // reason as walletConfig/miscExpenseDraft/taskConfig.
    match /artifacts/default-app-id/users/{userId}/settings/creditCardConfig {
      allow read, write: if isOwner(userId) && hasAppPermission('walletwatch');
    }

    // 10. Specific rule for WalletWatch's Credit Card cycle settlements — top-level
    // collection whose path segment ('cardCycleSettlements') doesn't match the
    // 'walletwatch' allowedApps key, same reason as fixedExpenseTemplates/Instances above.
    match /artifacts/default-app-id/users/{userId}/cardCycleSettlements/{docId} {
      allow read, write: if isOwner(userId) && hasAppPermission('walletwatch');
    }

    // 11. Specific rule for MediWatch's prescriptions collection — top-level
    // collection whose path segment ('prescriptions') doesn't match the
    // 'mediwatch' allowedApps key, same reason as quickTasks/changelogs above.
    match /artifacts/default-app-id/users/{userId}/prescriptions/{docId} {
      allow read, write: if isOwner(userId) && hasAppPermission('mediwatch');
    }

    // 12. Specific rule for WalletWatch's Cash Balance snapshots — top-level
    // collection whose path segment ('cashBalanceSnapshots') doesn't match the
    // 'walletwatch' allowedApps key, same reason as fixedExpenseTemplates/Instances above.
    match /artifacts/default-app-id/users/{userId}/cashBalanceSnapshots/{docId} {
      allow read, write: if isOwner(userId) && hasAppPermission('walletwatch');
    }

  }
}
